generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // Neon pooled connection string
  directUrl = env("DIRECT_URL")     // Neon direct connection string, used for migrations
}

enum AlertStatus {
  active
  paused
}

model Alert {
  id                String      @id @default(cuid())
  boardId           String
  boardName         String
  alertType         String      // stuck-in-list | no-activity | overdue-in-list | due-soon-unassigned | custom-condition
  conditions        Json
  recipients        Json        // includes recipients.frequency and recipients.creator for now
  status            AlertStatus @default(active)
  createdByMemberId String
  createdByName     String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  lastCheckedAt     DateTime?
  lastCheckStatus   String?   // ok | error | no_recipients
  lastCheckMessage  String?
  lastDigestSentAt  DateTime?
  notifications     AlertNotification[]

  @@index([boardId, createdAt])
  @@index([boardId, status])
}

model AlertNotification {
  id         String    @id @default(cuid())
  alertId    String
  alert      Alert     @relation(fields: [alertId], references: [id], onDelete: Cascade)
  cardId     String
  cardName   String
  cardUrl    String
  episodeAt  DateTime  @map("stuckSince")   // when this condition's clock started for the card
  detectedAt DateTime  @default(now())
  sentAt     DateTime?

  @@unique([alertId, cardId, episodeAt])
  @@index([alertId, sentAt])
}

model TrelloCredential {
  memberId  String    @id
  fullName  String?
  email     String?
  tokenEnc  String
  invalidAt DateTime?
  updatedAt DateTime  @updatedAt
}

model EmailSuppression {
  email     String   @id   // lowercased
  createdAt DateTime @default(now())
}
